# Copy to terraform.tfvars (gitignored). No secret values belong here.
project_id = "revel-gifts"
region     = "us-central1"

# Placeholder until the first real image is pushed; later rollouts use gcloud.
app_image = "us-docker.pkg.dev/cloudrun/container/hello"

openfga_image_tag = "v1.22.1"
public_base_url   = "https://api.revel.gifts"
mcp_path          = "/mcp"

# Public WorkOS AuthKit domain (not a secret). Until set, /mcp and /me return 401 (fail closed).
# Sets WORKOS_AUTHKIT_DOMAIN on revel-app. WORKOS_TOKEN_AUDIENCE is derived as
# public_base_url + mcp_path (https://api.revel.gifts/mcp) and must match the WorkOS resource indicator.
# workos_authkit_domain = "https://replace-with-authkit-domain.authkit.app"

# Public WorkOS client ID (not a secret) for the browser session; sets WORKOS_CLIENT_ID when non-empty.
# workos_client_id = "replace-with-workos-client-id"
# Empty uses public_base_url + /auth/callback (https://api.revel.gifts/auth/callback).
# workos_redirect_uri = ""

# OpenFGA store and authorization model IDs (ULIDs, not secrets) printed by the revel-fga-admin
# bootstrap run (infra/README.md, "OpenFGA bootstrap"). Each sets OPENFGA_STORE_ID /
# OPENFGA_AUTHORIZATION_MODEL_ID on revel-app and revel-fga-admin only when non-empty.
# openfga_store_id               = ""
# openfga_authorization_model_id = ""

# Scheduled OpenFGA reconcile (Cloud Scheduler -> revel-fga-reconcile job). Created only once both
# OpenFGA IDs above are set. Pause without an apply: gcloud scheduler jobs pause revel-fga-reconcile.
enable_fga_reconcile_schedule = true
fga_reconcile_schedule        = "*/15 * * * *" # Etc/UTC

# The deterministic run.app host is computed automatically. After the first apply, add the
# non-deterministic run.app host from `terraform output app_urls` here if you use that URL.
app_extra_allowed_hosts = []

migrate_command   = ["alembic", "upgrade", "head"]

# Add secret IDs here only after `gcloud secrets versions add` has created a version.
# For example, once both have versions:
# app_secret_env = ["WORKOS_API_KEY", "WORKOS_COOKIE_PASSWORD"]
app_secret_env = []

db_tier               = "db-f1-micro"
app_max_instances     = 2
deletion_protection   = true
enable_domain_mapping = false
domain_name           = "api.revel.gifts"

# Revel Gifts environment variables.
# Copy to .env for local development and replace the placeholders.
# Never commit .env. Deployed values live in GCP Secret Manager.
# F1 owns this file's structure; other features request new variables through F1.

# --- App ---
APP_ENV=development
# Public origin used for MCP metadata, OAuth redirects and host/origin allowlists.
# Deployed origin: https://api.revel.gifts (localhost for local development)
PUBLIC_BASE_URL=http://localhost:8000
MCP_PATH=/mcp
# Extra allowed MCP Host header values / browser Origins (comma-separated), e.g. the
# Cloud Run *.run.app hostname. PUBLIC_BASE_URL is always allowed; localhost too in development.
ALLOWED_HOSTS=
ALLOWED_ORIGINS=

# --- Google Cloud ---
GCP_PROJECT_ID=revel-gifts
GCP_PROJECT_NUMBER=1034867470814
GCP_REGION=us-central1

# --- Database (local Docker Compose defaults) ---
DATABASE_URL=postgresql+psycopg://revel:revel@localhost:5432/revel

# --- OpenFGA (local Docker Compose defaults) ---
OPENFGA_API_URL=http://localhost:8080
OPENFGA_STORE_ID=
OPENFGA_AUTHORIZATION_MODEL_ID=
# Attach a Google ID token to OpenFGA calls (true on Cloud Run, where OpenFGA is IAM-private)
OPENFGA_GOOGLE_AUTH=false

# --- WorkOS ---
WORKOS_API_KEY=replace-with-workos-api-key
WORKOS_CLIENT_ID=replace-with-workos-client-id
# AuthKit domain shown in the WorkOS dashboard, e.g. https://<subdomain>.authkit.app
WORKOS_AUTHKIT_DOMAIN=replace-with-authkit-domain
# Browser sign-in callback for the human UI
WORKOS_REDIRECT_URI=http://localhost:8000/auth/callback
# Secret used to encrypt browser session cookies (generate a long random string)
WORKOS_COOKIE_PASSWORD=replace-with-32+-char-random-string
# Expected MCP access-token audience; defaults to PUBLIC_BASE_URL + MCP_PATH when unset.
# WORKOS_TOKEN_AUDIENCE=http://localhost:8000/mcp

# --- Muse Spark (Revel internal intelligence) ---
# Fireworks-hosted Muse Spark
FIREWORKS_API_KEY=replace-with-fireworks-api-key
FIREWORKS_MODEL=replace-with-muse-spark-model-id
# Meta Model API (meta.ai), if that endpoint is the one that counts for the hackathon
META_API_KEY=replace-with-meta-api-key
META_MODEL=replace-with-muse-spark-model-id
# Which provider Revel calls: fireworks or meta
MUSE_SPARK_PROVIDER=fireworks
MUSE_SPARK_TIMEOUT_SECONDS=8
